<section class="service-strip" aria-label="Customer promises">
  <div class="page-width service-strip__grid">
    {%- for block in section.blocks -%}
      <p {{ block.shopify_attributes }}>
        <strong>{{ block.settings.heading }}</strong>
        <span>{{ block.settings.text }}</span>
      </p>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Service strip",
  "settings": [],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "One numbered pressing"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pressed once, never again."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service strip",
      "blocks": [
        { "type": "promise", "settings": { "heading": "One numbered pressing", "text": "Pressed once, never again." } },
        { "type": "promise", "settings": { "heading": "Thoughtfully packed", "text": "Signed off by the house." } },
        { "type": "promise", "settings": { "heading": "Here if you need us", "text": "Real correspondence, always." } }
      ]
    }
  ]
}
{% endschema %}
