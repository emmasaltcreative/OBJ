{%- liquid
  assign edition_collection = section.settings.collection
  if edition_collection == blank
    assign edition_collection = collections['the-first-edition']
  endif
  assign bundle_product = section.settings.bundle_product
-%}

<section class="bundle section">
  <div class="page-width bundle__inner">
    <div class="bundle__collage">
      {%- assign collage_fallbacks = 'product-chaperone.svg,product-candle.svg,product-good-glass.svg' | split: ',' -%}
      {%- for product in edition_collection.products limit: 3 -%}
        <div class="bundle__image bundle__image--{{ forloop.index }}">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 520, 800', alt: product.title }}
          {%- else -%}
            <img src="{{ collage_fallbacks[forloop.index0] | asset_url }}" alt="{{ product.title | escape }}" width="800" height="1000" loading="lazy">
          {%- endif -%}
        </div>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="bundle__image bundle__image--{{ i }}">
            <img src="{{ collage_fallbacks[forloop.index0] | asset_url }}" alt="" width="800" height="1000" loading="lazy">
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <div class="bundle__copy">
      <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p class="prose">{{ section.settings.text }}</p>
      <div class="bundle__price">
        <strong>
          {%- if bundle_product != blank -%}
            {{ bundle_product.price | money_without_trailing_zeros }}
          {%- else -%}
            {{ section.settings.price_text }}
          {%- endif -%}
        </strong>
        {%- if section.settings.compare_text != blank -%}
          <span>{{ section.settings.compare_text }}</span>
        {%- endif -%}
      </div>
      {%- if settings.edition_state != 'open' -%}
        <p class="edition-state-note edition-state-note--inline">
          {%- if settings.edition_state == 'retired' -%}{{ settings.retired_text }}{%- else -%}{{ settings.doors_text }}{%- endif -%}
        </p>
      {%- elsif bundle_product != blank -%}
        {%- form 'product', bundle_product -%}
          <input type="hidden" name="id" value="{{ bundle_product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button class="btn btn--solid" type="submit" {% unless bundle_product.available %}disabled{% endunless %}>
            {{ section.settings.button_label }}
          </button>
        {%- endform -%}
      {%- else -%}
        <a class="btn btn--solid" href="{{ edition_collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      <p class="bundle__note">{{ section.settings.note }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Complete edition bundle",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The complete reading hour"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The whole edition, gathered."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A coat for the paperback, a book for the lines worth keeping, a candle to open the hour, and the favorite glass. Four quiet pleasures, gathered as one set."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Edition collection"
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Bundle product"
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Fallback price text",
      "default": "$128"
    },
    {
      "type": "text",
      "id": "compare_text",
      "label": "Savings text",
      "default": "$142 separately · save $14"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add the complete edition"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Fulfillment note",
      "default": "Gathered as one set, packed as one parcel, signed off by the house."
    }
  ],
  "presets": [
    {
      "name": "Complete edition bundle"
    }
  ]
}
{% endschema %}
