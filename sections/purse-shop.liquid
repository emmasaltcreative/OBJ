{%- comment -%}
  The whole edition, shoppable.

  Every piece with its price and an add-to-cart, so a visitor can
  choose without loading a second page. The heading states the plain
  facts of the offer — how many pieces, and what they cost.
{%- endcomment -%}

{%- liquid
  assign shop_collection = section.settings.collection
  if shop_collection == blank and collection != blank
    assign shop_collection = collection
  endif
  if shop_collection == blank
    assign fallback_handle = section.settings.collection_handle
    if fallback_handle != blank
      assign shop_collection = collections[fallback_handle]
    endif
  endif

  assign products = shop_collection.products
  assign count = products.size
-%}

{%- if count > 0 -%}
  {%- liquid
    assign min_price = products.first.price
    assign max_price = products.first.price
    for product in products
      if product.price < min_price
        assign min_price = product.price
      endif
      if product.price > max_price
        assign max_price = product.price
      endif
    endfor

    assign summary = section.settings.summary
    if summary == blank
      capture piece_word
        if count == 1
          echo 'piece'
        else
          echo 'pieces'
        endif
      endcapture
      if min_price == max_price
        capture summary
          echo count
          echo ' '
          echo piece_word
          echo ', '
          echo min_price | money
          echo ' each. Made when you claim it.'
        endcapture
      else
        capture summary
          echo count
          echo ' '
          echo piece_word
          echo ', '
          echo min_price | money
          echo '–'
          echo max_price | money
          echo '. Made when you claim it.'
        endcapture
      endif
    endif

    assign grid_class = 'product-grid'
    if count < 4
      assign grid_class = 'product-grid product-grid--few'
    endif
  -%}

  <section class="section purse-shop" id="{{ section.settings.anchor | default: 'the-edition' | handle }}">
    <div class="page-width">
      <div class="section-header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        <p class="purse-shop__summary">{{ summary }}</p>
      </div>

      <div class="{{ grid_class }}">
        {%- for product in products -%}
          {% render 'product-card',
            product: product,
            number: forloop.index,
            quick_add: section.settings.quick_add,
            quick_add_label: section.settings.quick_add_label,
            choose_label: section.settings.choose_label
          %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section">
    <div class="page-width">
      <div class="errors">
        Pick a collection for this section, or add this section to a collection template.
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Shop the edition",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Every piece with its price and an add-to-cart, so nobody has to load a second page to find out what things cost."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty on a collection template to use the collection being viewed."
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Collection handle",
      "default": "in-her-purse",
      "info": "Used when no collection is picked and the page is not a collection page."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What's for sale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The whole of In Her Purse"
    },
    {
      "type": "textarea",
      "id": "summary",
      "label": "Summary",
      "info": "Leave blank to state the count and the price range automatically."
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Add-to-cart on each card",
      "default": true
    },
    {
      "type": "text",
      "id": "quick_add_label",
      "label": "Add-to-cart label",
      "default": "Add to my parcel"
    },
    {
      "type": "text",
      "id": "choose_label",
      "label": "Multi-variant label",
      "default": "Choose yours",
      "info": "Shown instead of add-to-cart when a piece has options to pick."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "the-edition"
    }
  ],
  "presets": [
    {
      "name": "Shop the edition"
    }
  ]
}
{% endschema %}
