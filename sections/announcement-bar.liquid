{%- comment -%}
  Announcement bar.

  Falling snow is decorative and drawn with CSS only — no JavaScript, no
  images. The flakes inherit the bar's own text colour through
  currentColor, so they follow the palette set in Theme settings and never
  need their own colour picker. Each flake's lane, size, speed, drift and
  opacity are derived from its index, which gives an irregular fall from a
  plain loop. Negative animation delays start them mid-flight, so the bar
  looks like it has been snowing since before the page loaded.

  The whole field is aria-hidden and skipped entirely for anyone who asks
  for reduced motion; the sentence alone remains.
{%- endcomment -%}

{%- comment -%}
  The seasonal line runs itself. A cutoff banner that outlives its cutoff
  is worse than no banner — "order by December 10th" still showing on the
  15th is a promise the house cannot keep — so the holiday sentence shows
  only between its two dates and the everyday one returns on its own.

  Dates are compared as plain integers (20261209) rather than strings,
  because Liquid's string comparison is not dependable. `now` follows the
  shop's own time zone.
{%- endcomment -%}
{%- liquid
  assign banner_text = section.settings.text

  assign today_num = 'now' | date: '%Y%m%d' | plus: 0
  assign start_num = section.settings.holiday_start | remove: '-' | plus: 0
  assign end_num = section.settings.holiday_end | remove: '-' | plus: 0

  if section.settings.holiday_text != blank and start_num > 0 and today_num >= start_num
    if end_num == 0 or today_num <= end_num
      assign banner_text = section.settings.holiday_text
    endif
  endif
-%}

{% if banner_text != blank %}
  {%- assign announcement_href = section.settings.link -%}
  {%- if announcement_href == blank -%}
    {%- if banner_text contains 'Purse' or banner_text contains 'Brownstone' -%}
      {%- assign announcement_href = '/#brownstone-tote' -%}
    {%- endif -%}
  {%- endif -%}
  <div class="announcement-bar{% if section.settings.show_snow %} announcement-bar--snow{% endif %}">
    {%- if section.settings.show_snow -%}
      <span class="obj-snow" aria-hidden="true">
        {%- for i in (1..18) -%}
          {%- liquid
            assign lane = forloop.index | times: 5.7 | modulo: 100
            assign dur = forloop.index | modulo: 5 | plus: 7
            assign delay = forloop.index | times: 7 | modulo: 11
            assign size = forloop.index | modulo: 3 | plus: 2
            assign fade = forloop.index | modulo: 4 | plus: 3
            assign drift = forloop.index | modulo: 7 | minus: 3 | times: 5
          -%}
          <i style="left: {{ lane }}%; width: {{ size }}px; height: {{ size }}px; animation-duration: {{ dur }}s; animation-delay: -{{ delay }}s; --obj-snow-drift: {{ drift }}px; --obj-snow-fade: 0.{{ fade }};"></i>
        {%- endfor -%}
      </span>
    {%- endif -%}
    <span class="announcement-bar__text">
      {% if announcement_href != blank %}
        <a href="{{ announcement_href }}" style="text-decoration: none; color: inherit;">{{ banner_text }}</a>
      {% else %}
        {{ banner_text }}
      {% endif %}
    </span>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Packed by hand in the USA · Free US shipping over $70 · The house reads every letter"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Seasonal line"
    },
    {
      "type": "paragraph",
      "content": "Replaces the text above between the two dates, then reverts on its own. Leave the text empty to turn it off."
    },
    {
      "type": "text",
      "id": "holiday_text",
      "label": "Seasonal text",
      "default": "Place Order by December 10th for Christmas Eve Delivery"
    },
    {
      "type": "text",
      "id": "holiday_start",
      "label": "Show from",
      "default": "2026-12-01",
      "info": "YYYY-MM-DD, in the shop's time zone."
    },
    {
      "type": "text",
      "id": "holiday_end",
      "label": "Stop after",
      "default": "2026-12-10",
      "info": "The last day it shows. Set this to the ordering cutoff itself, so the promise never outlives it."
    },
    {
      "type": "checkbox",
      "id": "show_snow",
      "label": "Falling snow",
      "default": true,
      "info": "Decorative only. Hidden automatically for visitors who ask for reduced motion."
    }
  ]
}
{% endschema %}

{% stylesheet %}
.announcement-bar--snow {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}

.announcement-bar--snow .announcement-bar__text {
  position: relative;
  z-index: 1;
}

.obj-snow {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

/*
  The fall is driven by `top`, not by a percentage inside translate():
  a percentage in translate() resolves against the element's own box, and
  these flakes are 2-4px across, so translateY(180%) moved them about five
  pixels and piled them along the top edge. `top: 100%` resolves against
  the bar instead, so one flake crosses the whole bar whatever its height
  — a wrapped two-line bar on a phone included. translate() is left to do
  the sideways drift only.
*/
.obj-snow i {
  position: absolute;
  top: -6px;
  display: block;
  border-radius: 50%;
  background: currentColor;
  opacity: 0;
  will-change: top, transform, opacity;
  animation-name: obj-snow-fall;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes obj-snow-fall {
  0% {
    top: -6px;
    transform: translate3d(0, 0, 0);
    opacity: 0;
  }
  18% {
    opacity: var(--obj-snow-fade, 0.5);
  }
  82% {
    opacity: var(--obj-snow-fade, 0.5);
  }
  100% {
    top: 100%;
    transform: translate3d(var(--obj-snow-drift, 0px), 0, 0);
    opacity: 0;
  }
}

/* The sentence is the point; the weather is not. */
@media (prefers-reduced-motion: reduce) {
  .obj-snow { display: none; }
}
{% endstylesheet %}
