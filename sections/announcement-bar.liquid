{% if section.settings.text != blank %}
  {%- assign announcement_href = section.settings.link -%}
  {%- if announcement_href == blank -%}
    {%- if section.settings.text contains 'Chaperone' -%}
      {%- assign announcement_href = '/products/the-chaperone' -%}
    {%- elsif section.settings.text contains 'Purse' or section.settings.text contains 'Brownstone' -%}
      {%- assign announcement_href = '/#brownstone-tote' -%}
    {%- endif -%}
  {%- endif -%}
  <div class="announcement-bar">
    {% if announcement_href != blank %}
      <a href="{{ announcement_href }}" style="text-decoration: none; color: inherit;">{{ section.settings.text }}</a>
    {% else %}
      {{ section.settings.text }}
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "The debut — In Her Purse. The Brownstone Tote by Betty."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
