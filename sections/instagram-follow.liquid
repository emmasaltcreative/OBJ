{%- comment -%}
  Follow the house on Instagram.

  Not a live feed. Instagram retired the Basic Display API in December 2024 and
  deprecated oEmbed Read in November 2025, so there is no longer a way to read a
  profile's recent posts from theme code — it needs an authenticated, token
  refreshing integration, and a token cannot live in a public theme.

  So the tiles are chosen here instead, in the theme editor. That buys two
  things a widget cannot: the grid looks like the rest of the house, and a reel
  can be a real video file that actually moves. Instagram's own embeds render a
  still thumbnail.

  A tile takes a video or an image. Video wins when both are set.
{%- endcomment -%}

{%- liquid
  assign handle = section.settings.handle | strip | remove: '@'
  assign profile = 'https://www.instagram.com/' | append: handle | append: '/'
-%}

<section class="ig section" id="{{ section.settings.anchor | default: 'instagram' }}">
  <div class="page-width">
    <div class="ig__head">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p class="ig__note">{{ section.settings.text }}</p>
      {% endif %}
    </div>

    {%- assign tiles = section.blocks | where: 'type', 'tile' -%}

    {%- comment -%}
      An app block renders its own feed, so it is not a tile and must not be
      wrapped in one. Socialwidget, Instafeed and the rest go here, between the
      heading and the follow button, keeping the house frame around a live feed.
    {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="ig__app" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if tiles.size > 0 -%}
      <ul class="ig__grid" role="list">
        {%- for block in tiles -%}
          <li class="ig__tile" {{ block.shopify_attributes }}>
            <a
              href="{{ block.settings.link | default: profile }}"
              class="ig__link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {%- if block.settings.video != blank -%}
                {{
                  block.settings.video
                  | video_tag:
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    playsinline: true,
                    class: 'ig__media',
                    image_size: '640x'
                }}
                <span class="ig__badge" aria-hidden="true">Reel</span>
              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 640
                  | image_tag:
                    loading: 'lazy',
                    widths: '320, 480, 640',
                    class: 'ig__media',
                    alt: block.settings.image.alt | default: block.settings.caption
                }}
              {%- endif -%}

              {%- if block.settings.caption != blank -%}
                <span class="visually-hidden">{{ block.settings.caption }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="ig__cta">
      <a href="{{ profile }}" class="btn btn--solid" target="_blank" rel="noopener noreferrer">
        {{ section.settings.button_label }}
      </a>
      <p class="ig__handle">
        <a href="{{ profile }}" target="_blank" rel="noopener noreferrer">&#64;{{ handle }}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .ig__head { text-align: center; max-width: 36rem; margin: 0 auto clamp(1.8rem, 4vw, 2.6rem); }
  .ig__head h2 { margin-bottom: 0.4em; }
  .ig__note { color: var(--ink-soft); margin: 0; }

  .ig__grid {
    list-style: none;
    margin: 0 0 clamp(1.8rem, 4vw, 2.6rem);
    padding: 0;
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    gap: clamp(0.5rem, 1.4vw, 0.9rem);
  }

  .ig__tile { margin: 0; }

  .ig__link {
    position: relative;
    display: block;
    aspect-ratio: {{ section.settings.ratio }};
    overflow: hidden;
    background: var(--color-paper);
    text-decoration: none;
    border: 1px solid var(--line);
  }

  .ig__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .ig__link:hover .ig__media { transform: scale(1.03); }

  .ig__badge {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .ig__app { margin: 0 0 clamp(1.8rem, 4vw, 2.6rem); }

  .ig__cta { text-align: center; }
  .ig__handle { margin: 0.9rem 0 0; color: var(--ink-soft); font-size: 0.9rem; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 749px) {
    .ig__grid { grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ig__media { transition: none; }
    .ig__link:hover .ig__media { transform: none; }
  }
</style>

<script>
  (function () {
    /* Autoplay is set in markup so the video moves for everyone who wants it.
       Anyone who has asked their system for less motion gets a still frame. */
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.ig__media video, video.ig__media').forEach(function (v) {
      v.autoplay = false;
      v.removeAttribute('autoplay');
      v.pause();
    });
  })();
</script>

{% schema %}
{
  "name": "Instagram",
  "tag": "section",
  "class": "section-instagram",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Elsewhere" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the house" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The things that do not make it into an edition. Mornings, scraps, the long way home."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram handle",
      "default": "ohbettyjaletti",
      "info": "Without the @."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow on Instagram" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2, "max": 6, "step": 1, "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1, "max": 3, "step": 1, "default": 2
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Tile shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "9 / 16", "label": "Reel" }
      ],
      "default": "1 / 1"
    },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "instagram" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "tile",
      "name": "Post",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Reel or video",
          "info": "Plays muted and loops. Takes priority over the image."
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link to the post" },
        {
          "type": "text",
          "id": "caption",
          "label": "Description",
          "info": "For screen readers, and as the image's alt text."
        }
      ]
    }
  ],
  "presets": [{ "name": "Instagram" }]
}
{% endschema %}
