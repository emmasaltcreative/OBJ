{%- comment -%}
  The products of a collection, laid out for a landing page.
  Defaults to the collection being viewed; a collection can also be picked
  so the section works on the homepage or any page template.
{%- endcomment -%}

{%- assign target = section.settings.collection | default: collection -%}
{%- assign columns = section.settings.columns -%}

<section class="section" id="{{ section.settings.anchor | default: 'the-inventory' | handle }}">
  <div class="page-width">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <p>{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    {% if target.products.size > 0 %}
      <div class="product-grid product-grid--{{ columns }}">
        {% for product in target.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}

        {% if section.settings.show_coming_card %}
          <div class="product-card product-card--coming">
            <div class="product-card__no">{{ section.settings.coming_numeral | escape }}</div>
            <h3 class="product-card__title">{{ section.settings.coming_heading }}</h3>
            <p class="product-card__coming-text">{{ section.settings.coming_text }}</p>
            {% if section.settings.coming_link_label != blank %}
              <a href="{{ section.settings.coming_link | default: '#correspondence' }}" class="link-arrow">
                {{ section.settings.coming_link_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="utility-page">
        <h2>Between editions</h2>
        <p style="color: var(--ink-soft);">Nothing here at the moment — we make something new and never look back. The letter will tell you first.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The inventory"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Turned out on the table"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank on a collection template to use the collection being viewed."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "the-inventory",
      "info": "Used by links such as the collection hero's."
    },
    {
      "type": "header",
      "content": "The \"more coming\" card"
    },
    {
      "type": "paragraph",
      "content": "A card at the end of the grid, for a collection that is still filling up. Switch it off once there are enough pieces to carry the row."
    },
    {
      "type": "checkbox",
      "id": "show_coming_card",
      "label": "Show the card",
      "default": true
    },
    {
      "type": "text",
      "id": "coming_numeral",
      "label": "Numeral",
      "default": "&c."
    },
    {
      "type": "text",
      "id": "coming_heading",
      "label": "Heading",
      "default": "The rest is still being cut"
    },
    {
      "type": "textarea",
      "id": "coming_text",
      "label": "Text",
      "default": "The collection fills up slowly, on purpose. Card cases, a long strap, the little pouch that keeps the loose things from becoming a situation — each one gets its turn on the table."
    },
    {
      "type": "text",
      "id": "coming_link_label",
      "label": "Link label",
      "default": "Hear about the next one"
    },
    {
      "type": "url",
      "id": "coming_link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Collection grid"
    }
  ]
}
{% endschema %}
