{%- comment -%}
  The products of a collection, laid out for a landing page.
{%- endcomment -%}

{%- assign target = section.settings.collection | default: collection -%}
{%- assign columns = section.settings.columns -%}

<section class="section collection-grid" id="{{ section.settings.anchor | default: 'the-inventory' | handle }}">
  <div class="page-width">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <p>{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    {% if target.products.size > 0 %}
      <div class="product-grid product-grid--{{ columns }}">
        {% for product in target.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}

        {% if section.settings.show_coming_card %}
          <div class="product-card product-card--coming">
            <div class="product-card__no">{{ section.settings.coming_numeral | escape }}</div>
            <h3 class="product-card__title">{{ section.settings.coming_heading }}</h3>
            <p class="product-card__coming-text">{{ section.settings.coming_text }}</p>
            {% if section.settings.coming_link_label != blank %}
              <a href="{{ section.settings.coming_link | default: '#correspondence' }}" class="link-arrow">
                {{ section.settings.coming_link_label }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="utility-page">
        <h2>Between editions</h2>
        <p style="color: var(--ink-soft);">Nothing here at the moment. The letter will tell you first.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The inventory" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Turned out on the table" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave blank on a collection template to use the collection being viewed." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ],
      "default": "2"
    },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "the-inventory" },
    { "type": "header", "content": "The 'more coming' card" },
    { "type": "checkbox", "id": "show_coming_card", "label": "Show the card", "default": true },
    { "type": "text", "id": "coming_numeral", "label": "Numeral", "default": "&c." },
    { "type": "text", "id": "coming_heading", "label": "Heading", "default": "The rest is still being cut" },
    { "type": "textarea", "id": "coming_text", "label": "Text", "default": "The collection fills up slowly, on purpose." },
    { "type": "text", "id": "coming_link_label", "label": "Link label", "default": "Hear about the next one" },
    { "type": "url", "id": "coming_link", "label": "Link" }
  ],
  "presets": [{ "name": "Collection grid" }]
}
{% endschema %}

{% stylesheet %}
.product-grid--2 { grid-template-columns: repeat(2, 1fr); }
.product-grid--3 { grid-template-columns: repeat(3, 1fr); }
.product-grid--4 { grid-template-columns: repeat(4, 1fr); }
.product-grid--2 .product-card { padding: clamp(1.6rem, 3vw, 2.6rem); }
.product-grid--2 .product-card__media { aspect-ratio: 1 / 1; }
@media (max-width: 1020px) {
  .product-grid--3,
  .product-grid--4 { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 560px) {
  .product-grid--2,
  .product-grid--3,
  .product-grid--4 { grid-template-columns: 1fr; }
}
.product-card--coming {
  background: var(--color-background);
  justify-content: center;
  padding: clamp(2rem, 4vw, 3rem);
}
.product-card--coming .product-card__title { font-style: italic; margin-bottom: 0.8rem; }
.product-card__coming-text { color: var(--ink-soft); font-size: 0.98rem; margin-bottom: 1.6rem; }
@media (max-width: 749px) {
  .collection-grid { padding-top: 2.25rem; }
  .collection-grid .section-header { margin-bottom: 1.75rem; }
}
{% endstylesheet %}
