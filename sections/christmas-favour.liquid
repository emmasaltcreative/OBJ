{%- comment -%}
  The Letter Tray — the house's Christmas favour.
  Sealed envelopes in place of a spinning wheel: the visitor chooses one, it unseals,
  and afterwards the tray discloses what the other envelopes held. One draw, remembered.
{%- endcomment -%}

{%- liquid
  assign favour_count = section.blocks.size

  capture signature
    for block in section.blocks
      echo block.id
      echo '-'
      echo block.settings.code | handle
      echo '-'
    endfor
  endcapture
  assign signature = signature | strip | handle

  assign unlocked = true
  if section.settings.require_email
    assign unlocked = false
  endif
-%}

<section class="section favour"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handle }}"{% endif %}>
  <div class="page-width">
    <div class="section-header favour__head">
      <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <p>{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    {% if section.settings.require_email %}
      <div class="favour__gate">
        {% form 'customer' %}
          {%- if form.posted_successfully? -%}{%- assign unlocked = true -%}{%- endif -%}
          {% unless unlocked %}
            {% if form.errors %}
              <div class="errors">{{ form.errors | default_errors }}</div>
            {% endif %}
            <p class="favour__gate-text">{{ section.settings.gate_text }}</p>
            <input type="hidden" name="contact[tags]" value="{{ section.settings.tags | default: 'newsletter, christmas-favour' | escape }}">
            <div class="newsletter__form">
              <input type="email" name="contact[email]" placeholder="Your email" aria-label="Email" required>
              <button type="submit" class="btn btn--solid">{{ section.settings.gate_button | default: 'Bring me the tray' }}</button>
            </div>
            <p class="newsletter__note">{{ section.settings.gate_note }}</p>
          {% else %}
            <p class="favour__gate-text favour__gate-text--done">{{ section.settings.unlocked_text }}</p>
          {% endunless %}
        {% endform %}
      </div>
    {% endif %}

    {% if unlocked and favour_count > 0 %}
      <div
        class="favour__tray"
        data-favour
        data-storage-key="obj-favour--{{ section.id }}--{{ signature }}"
        data-apply-redirect="{{ section.settings.apply_redirect | default: '/collections/all' }}"
        data-repeat-text="{{ section.settings.repeat_text | escape }}"
        data-others-label="{{ section.settings.others_label | escape }}"
        data-chosen-label="{{ section.settings.chosen_label | escape }}"
      >
        <div class="favour__envelopes" data-favour-envelopes role="group" aria-label="{{ section.settings.heading | strip_html | escape }}">
          {% for block in section.blocks %}
            <button
              type="button"
              class="favour__envelope"
              data-favour-envelope
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <span class="favour__lining" aria-hidden="true"></span>
              <span class="favour__flap" aria-hidden="true"></span>
              <span class="favour__seal" aria-hidden="true">{{ section.settings.seal | default: 'B' }}</span>
              <span class="favour__envelope-no">
                <span class="visually-hidden">{{ section.settings.envelope_word | default: 'Open envelope' }} </span>No. {{ forloop.index }}
              </span>
            </button>
          {% endfor %}
        </div>

        <p class="favour__hint" data-favour-hint>{{ section.settings.hint }}</p>

        <div class="favour__note" data-favour-note hidden>
          <div class="favour__card" role="status" aria-live="polite">
            <span class="eyebrow eyebrow--accent">{{ section.settings.card_kicker | default: 'Your favour' }}</span>
            <p class="favour__chosen" data-favour-chosen></p>
            <h3 class="favour__label" data-favour-label></h3>
            <p class="favour__text" data-favour-text></p>

            <div class="favour__code" data-favour-code-wrap hidden>
              <span class="favour__code-value" data-favour-code></span>
              <button
                type="button"
                class="favour__copy"
                data-favour-copy
                data-copied="{{ section.settings.copied_label | default: 'Copied' | escape }}"
              >{{ section.settings.copy_label | default: 'Copy' }}</button>
            </div>

            <a class="btn btn--solid favour__apply" data-favour-apply href="#" hidden>
              {{ section.settings.apply_label | default: 'Carry it to my parcel →' }}
            </a>

            <p class="favour__others" data-favour-others></p>
            <p class="favour__repeat" data-favour-repeat hidden></p>
          </div>
        </div>

        <script type="application/json" data-favour-pool>
          [
            {%- for block in section.blocks -%}
              {
                "id": {{ block.id | json }},
                "label": {{ block.settings.label | json }},
                "code": {{ block.settings.code | strip | upcase | json }},
                "note": {{ block.settings.note | json }},
                "aside": {{ block.settings.aside | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>

        <noscript>
          <p class="favour__hint">{{ section.settings.noscript_text }}</p>
        </noscript>
      </div>

      {% if section.settings.terms != blank %}
        <p class="favour__terms">{{ section.settings.terms }}</p>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "The Letter Tray",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A favour from the house"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Letter Tray"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "No wheel, no whistles. Three envelopes on the hall tray, each sealed with wax, each with something small inside. Choose one and the house will tell you afterwards what the others held."
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Hint under the envelopes",
      "default": "Choose an envelope. The house does not shuffle twice."
    },
    {
      "type": "text",
      "id": "seal",
      "label": "Letter on the wax seal",
      "default": "B"
    },
    {
      "type": "header",
      "content": "The opened letter"
    },
    {
      "type": "text",
      "id": "card_kicker",
      "label": "Card eyebrow",
      "default": "Your favour"
    },
    {
      "type": "text",
      "id": "chosen_label",
      "label": "Chosen line",
      "default": "You chose No. [n].",
      "info": "[n] becomes the number of the envelope."
    },
    {
      "type": "text",
      "id": "others_label",
      "label": "Disclosure line",
      "default": "The tray also held: [list].",
      "info": "[list] becomes the favours left behind. Shown so the draw is in plain sight."
    },
    {
      "type": "text",
      "id": "repeat_text",
      "label": "On a return visit",
      "default": "This is the envelope you opened. The house keeps a record."
    },
    {
      "type": "text",
      "id": "copy_label",
      "label": "Copy button",
      "default": "Copy"
    },
    {
      "type": "text",
      "id": "copied_label",
      "label": "Copy button, once copied",
      "default": "Copied"
    },
    {
      "type": "text",
      "id": "apply_label",
      "label": "Apply button",
      "default": "Carry it to my parcel →"
    },
    {
      "type": "text",
      "id": "apply_redirect",
      "label": "Apply button sends them to",
      "default": "/collections/all",
      "info": "The code is applied at checkout, then the visitor lands here."
    },
    {
      "type": "textarea",
      "id": "terms",
      "label": "The small print",
      "default": "One favour to a household, and one only — the house would notice. Codes last until the last post for Christmas and do not stack."
    },
    {
      "type": "textarea",
      "id": "noscript_text",
      "label": "Without JavaScript",
      "default": "The envelopes need a little JavaScript to open. Leave an address below and the house will send a favour by hand instead."
    },
    {
      "type": "header",
      "content": "Ask for an address first"
    },
    {
      "type": "checkbox",
      "id": "require_email",
      "label": "Ask for an address before the tray appears",
      "default": false
    },
    {
      "type": "textarea",
      "id": "gate_text",
      "label": "Gate text",
      "default": "The tray is brought out for correspondents. Leave an address and it appears."
    },
    {
      "type": "text",
      "id": "gate_button",
      "label": "Gate button",
      "default": "Bring me the tray"
    },
    {
      "type": "text",
      "id": "gate_note",
      "label": "Gate note",
      "default": "We write rarely and beautifully. Unsubscribe whenever, no hard feelings."
    },
    {
      "type": "text",
      "id": "unlocked_text",
      "label": "After the address is left",
      "default": "Thank you. The tray is on the table — choose an envelope."
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Customer tags",
      "default": "newsletter, christmas-favour"
    },
    {
      "type": "text",
      "id": "envelope_word",
      "label": "Envelope button wording (for screen readers)",
      "default": "Open envelope"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "the-favour"
    }
  ],
  "blocks": [
    {
      "type": "favour",
      "name": "Favour",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Favour",
          "default": "Ten percent, quietly"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Discount code",
          "info": "Create the matching code under Discounts. Leave empty for a favour that needs no code — say so in the note instead."
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Note inside the envelope",
          "default": "Ten percent off your parcel, with no minimum and no countdown to the countdown."
        },
        {
          "type": "text",
          "id": "aside",
          "label": "Short name for the disclosure",
          "default": "ten percent",
          "info": "How this favour is named when the house says what the other envelopes held."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "The Letter Tray",
      "blocks": [
        {
          "type": "favour",
          "settings": {
            "label": "Ten percent, quietly",
            "code": "QUIETLY10",
            "note": "Ten percent off your parcel, with no minimum and no countdown to the countdown.",
            "aside": "ten percent"
          }
        },
        {
          "type": "favour",
          "settings": {
            "label": "The good wrapping",
            "code": "GOODPAPER",
            "note": "Tissue, ribbon and a hand-written card, folded at the table before your parcel goes out.",
            "aside": "the good wrapping"
          }
        },
        {
          "type": "favour",
          "settings": {
            "label": "The long way, paid for",
            "code": "LONGWAY",
            "note": "Shipping on the house. Sent the long way all the same.",
            "aside": "shipping on the house"
          }
        }
      ]
    }
  ]
}
{% endschema %}
