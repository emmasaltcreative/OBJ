{%- comment -%}
  The advertised piece, first.

  Ad traffic lands here, so the first screen has to answer the three
  questions the creative already raised: is this the thing I just saw,
  what does it cost, and how do I buy it. Image, name, price, and an
  add-to-cart live above the fold. The storytelling comes after.

  The lead product is resolved in this order:
  1. the "Lead product" setting
  2. the "Lead product handle" setting
  3. the first available product in the collection being viewed
{%- endcomment -%}

{%- liquid
  assign lead = section.settings.product

  if lead == blank
    assign lead_handle = section.settings.product_handle
    if lead_handle != blank
      assign lead = all_products[lead_handle]
    endif
  endif

  if lead == blank and collection != blank
    for candidate in collection.products
      if candidate.available
        assign lead = candidate
        break
      endif
    endfor
    if lead == blank
      assign lead = collection.products.first
    endif
  endif

  assign variant = blank
  if lead != blank
    assign variant = lead.selected_or_first_available_variant
  endif

  assign heading_tag = section.settings.heading_tag | default: 'h1'
-%}

{%- if lead == blank or variant == blank -%}
  {%- comment -%} Nothing to sell yet — say so plainly instead of rendering an empty frame. {%- endcomment -%}
  {%- if request.design_mode -%}
    <section class="section">
      <div class="page-width">
        <div class="errors">
          Pick a lead product for this section. Ad traffic needs a buyable piece on the first screen.
        </div>
      </div>
    </section>
  {%- endif -%}
{%- else -%}

  {%- liquid
    capture preorder_flag
      render 'is-preorder', product: lead
    endcapture
    assign is_preorder = false
    if preorder_flag contains 'true'
      assign is_preorder = true
    endif

    assign price_label = variant.price | money

    assign cta = section.settings.cta
    if cta == blank
      if is_preorder
        assign cta = 'Preorder →'
      else
        assign cta = 'Add to my parcel →'
      endif
    endif
    assign cta = cta | replace: '[price]', price_label

    assign sold_out_label = section.settings.sold_out_label | default: 'Between editions'
    if is_preorder and sold_out_label == 'Between editions'
      assign sold_out_label = 'Preorder closed'
    endif

    assign promise = section.settings.promise
    if promise == blank
      assign promise = settings.fulfillment_line
    endif
    assign promise = promise | replace: '[price]', price_label

    assign heading = section.settings.heading | default: lead.title
    assign ships = section.settings.preorder_ships | default: 'With the first edition'
  -%}

  <section class="section purse-lead" id="{{ section.settings.anchor | default: 'shop' | handle }}">
    <div class="page-width purse-lead__grid">
      <figure class="purse-lead__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'purse-lead__img', widths: '500, 800, 1200, 1600', alt: section.settings.image.alt | default: lead.title }}
        {%- elsif lead.featured_image != blank -%}
          {{ lead.featured_image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'purse-lead__img', widths: '500, 800, 1200, 1600', alt: lead.featured_image.alt | default: lead.title }}
        {%- elsif lead.handle == 'the-brownstone-tote' -%}
          {% render 'brownstone-image', loading: 'eager', alt: lead.title, class: 'purse-lead__img' %}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg purse-lead__img' }}
        {%- endif -%}
      </figure>

      <div
        class="purse-lead__info"
        data-product-form
        data-money-format="{{ shop.money_format | strip_html | escape }}"
        {% if is_preorder %}data-preorder="true"{% endif %}
      >
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <{{ heading_tag }} class="purse-lead__title">{{ heading }}</{{ heading_tag }}>

        {%- if section.settings.byline != blank -%}
          <p class="purse-lead__byline">{{ section.settings.byline }}</p>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="purse-lead__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <div class="purse-lead__price">
          {%- if is_preorder -%}
            <span class="purse-lead__price-kicker">Preorder price</span>
          {%- endif -%}
          <span data-price>{{ price_label }}</span>
          <span class="price--compare" data-compare-price
            {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>
            {{ variant.compare_at_price | money }}
          </span>
          {%- if lead.type != blank -%}
            <span class="purse-lead__type">{{ lead.type }}</span>
          {%- endif -%}
        </div>

        {%- if section.settings.offer != blank -%}
          <p class="purse-lead__offer">{{ section.settings.offer }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="purse-lead__facts">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span>{{ block.settings.label }}</span>
                <div>{{ block.settings.value }}</div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {% form 'product', lead, class: 'purse-lead__form' %}
          {{ form.errors | default_errors }}
          <input type="hidden" name="id" value="{{ variant.id }}">
          {%- if is_preorder -%}
            {% render 'preorder-properties', ships: ships %}
          {%- endif -%}

          {%- unless lead.has_only_default_variant -%}
            {%- for option in lead.options_with_values -%}
              <div class="field">
                <label for="LeadOption-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                <select id="LeadOption-{{ section.id }}-{{ forloop.index0 }}" data-option-select>
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                      {{ value }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <input type="hidden" name="quantity" value="1">

          <button
            type="submit"
            name="add"
            class="btn btn--solid btn--full purse-lead__buy"
            data-buy-button
            data-label-default="{{ cta | escape }}"
            data-label-sold-out="{{ sold_out_label | escape }}"
            {% unless variant.available %}disabled{% endunless %}
          >
            {%- if variant.available -%}{{ cta }}{%- else -%}{{ sold_out_label }}{%- endif -%}
          </button>
        {% endform %}

        {%- if promise != blank -%}
          <p class="purse-lead__promise">{{ promise }}</p>
        {%- endif -%}

        <p class="purse-lead__links">
          <a class="link-arrow" href="{{ lead.url }}">{{ section.settings.details_label | default: 'All the particulars' }}</a>
          {%- if section.settings.secondary_label != blank -%}
            <a class="purse-lead__secondary" href="{{ section.settings.secondary_link | default: '#the-edition' }}">{{ section.settings.secondary_label }}</a>
          {%- endif -%}
        </p>

        <script type="application/json" data-variants-json>
          {{ lead.variants | json }}
        </script>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Lead product",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The first screen for ad traffic. Set the image, heading, and offer to match the creative that sent the visitor here, so the page looks like the ad they just tapped."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Lead product"
    },
    {
      "type": "text",
      "id": "product_handle",
      "label": "Lead product handle",
      "info": "Used when no product is picked above. Falls back to the first available product in the collection."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "h1 — this section is the top of the page" },
        { "value": "h2", "label": "h2 — another section carries the h1" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "In Her Purse · No. 1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the product title. Match the ad's wording."
    },
    {
      "type": "text",
      "id": "byline",
      "label": "Byline",
      "default": "by Betty"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "One line on what it is",
      "default": "Brown faux-suede tote, cut full, with a silk scarf knotted at the handle."
    },
    {
      "type": "text",
      "id": "offer",
      "label": "Offer line",
      "info": "The promise the ad made — a shipping threshold, a scarf included, a numbered edition. Leave blank to omit."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Use the exact photograph from the ad. Leave empty to use the product's featured image."
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Add-to-cart label",
      "default": "Claim the tote — [price] →",
      "info": "Use [price] to print the variant price in the button."
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Unavailable label",
      "default": "Between editions"
    },
    {
      "type": "textarea",
      "id": "promise",
      "label": "Promise under the button",
      "info": "Leave blank for the house fulfillment line. Use [price] for the variant price."
    },
    {
      "type": "text",
      "id": "preorder_ships",
      "label": "Preorder ship note",
      "default": "With the first edition"
    },
    {
      "type": "text",
      "id": "details_label",
      "label": "Details link label",
      "default": "All the particulars"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Second link label",
      "default": "Or see both pieces ↓"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Second link"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "default": "shop"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Suede"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Brown, full, and soft"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Lead product",
      "blocks": [
        { "type": "fact", "settings": { "label": "Suede", "value": "Brown, full, and soft" } },
        { "type": "fact", "settings": { "label": "Scarf", "value": "Mulberry silk, knotted at the handle" } },
        { "type": "fact", "settings": { "label": "Fits", "value": "A paperback, a letter, and the day" } }
      ]
    }
  ]
}
{% endschema %}
