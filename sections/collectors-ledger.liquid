<section class="section">
  <div class="page-width narrow" style="max-width: 40rem;">
    <div style="text-align: center;">
      <img src="{{ 'obj-seal.svg' | asset_url }}" alt="" width="96" height="64" style="margin: 0 auto 1.5rem;">
      <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      <h1 class="title-quiet">{{ section.settings.heading }}</h1>
    </div>

    <div class="prose prose--quiet" style="margin-top: 2rem;">
      {{ section.settings.intro }}
    </div>

    <div class="ledger-tiers">
      {% for block in section.blocks %}
        <div class="ledger-tier" {{ block.shopify_attributes }}>
          <span class="ritual__numeral">{{ block.settings.numeral }}</span>
          <div>
            <h3 style="margin-bottom: 0.3rem;">{{ block.settings.title }}</h3>
            <p class="ledger-tier__standing">{{ block.settings.standing }}</p>
            <p class="ledger-tier__perk">{{ block.settings.perk }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

    <p class="cta-note" style="text-align: center; margin-top: 2.5rem;">{{ section.settings.closing }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Collector's ledger",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Collector's Ledger"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Standing in the house"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>The house does not do points. It keeps a ledger. Your edition number is claimed the day you join the waitlist, and it is yours for life: on every object, in every edition, for as long as you keep collecting. What grows is your standing.</p>"
    },
    {
      "type": "text",
      "id": "closing",
      "label": "Closing line",
      "default": "No cards to carry, no points to count. The ledger remembers."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "numeral",
          "label": "Numeral",
          "default": "I."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tier name",
          "default": "Reader"
        },
        {
          "type": "text",
          "id": "standing",
          "label": "Standing",
          "default": "One edition collected"
        },
        {
          "type": "textarea",
          "id": "perk",
          "label": "What the house does",
          "default": "Your number is held for every future edition."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collector's ledger",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "numeral": "I.",
            "title": "Reader",
            "standing": "One edition collected",
            "perk": "Your number is held across every future edition, and the doors open for you before the public."
          }
        },
        {
          "type": "tier",
          "settings": {
            "numeral": "II.",
            "title": "Collector",
            "standing": "Two editions collected",
            "perk": "The doors open for you a full day before the waitlist. First look at the pattern for the next pressing."
          }
        },
        {
          "type": "tier",
          "settings": {
            "numeral": "III.",
            "title": "Keeper of the House",
            "standing": "Four editions collected",
            "perk": "A letter from B. in the post, a courtesy gift with your parcel, and a say in what the house presses next."
          }
        }
      ]
    }
  ]
}
{% endschema %}
