<section class="section">
  <div class="page-width">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="ritual__grid">
      {% for block in section.blocks %}
        <div class="ritual__item" {{ block.shopify_attributes }}>
          <span class="ritual__numeral">{{ block.settings.numeral }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "The ritual",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How the house works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The long way, on purpose"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "numeral",
          "label": "Numeral",
          "default": "I."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Made for you"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Nothing exists until you order it."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "The ritual",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "numeral": "I.",
            "heading": "You claim it",
            "text": "Nothing here waits in a warehouse. Your piece doesn't exist until you decide it should."
          }
        },
        {
          "type": "step",
          "settings": {
            "numeral": "II.",
            "heading": "We make it",
            "text": "Printed, bound, or poured — one at a time, over a few unhurried days. Good things, etc."
          }
        },
        {
          "type": "step",
          "settings": {
            "numeral": "III.",
            "heading": "It takes the long way",
            "text": "Packed for you, signed off by the house, and sent the way a good letter travels: to you, and no one else."
          }
        }
      ]
    }
  ]
}
{% endschema %}
