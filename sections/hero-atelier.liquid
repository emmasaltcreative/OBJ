{%- comment -%}
  v5.7 hero: the flat-lay photograph with the waitlist claim form as the
  primary call to action. The panel floats over the image on wide screens
  and stacks beneath it on small ones. The form is a standard customer
  form: theme.js picks it up for the introduction code and the sessionStorage
  email that the sealed page's share block needs.
{%- endcomment -%}

<section class="hero-atelier">
  <div class="hero-atelier__media">
    <img
      src="{{ 'obj-hero-atelier.jpg' | asset_url }}"
      alt="The Oh Betty Jaletti worktable in preproduction: concept sketches for the heirloom book cover beside linen, poplin and bookcloth swatches, with the house monogram and the words unreasonably pretty things, made with intention"
      width="1800" height="675"
      fetchpriority="high">
  </div>

  <div class="page-width hero-atelier__frame">
    <div class="hero-atelier__panel">
      <p class="hero-atelier__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="hero-atelier__title">{{ section.settings.heading }}</h1>
      <p class="hero-atelier__sub">{{ section.settings.subheading }}</p>

      <div class="hero-atelier__cta" id="claim">
        {% form 'customer', class: 'hero-atelier__form' %}
          {% if form.posted_successfully? %}
            <p class="hero-atelier__fine">Your name is in Betty&rsquo;s guest book. You&rsquo;ll receive her letters, quiet glimpses behind the scenes, and an invitation when Edition One is ready.</p>
          {% else %}
            {% if form.errors %}
              <div class="errors">{{ form.errors | default_errors }}</div>
            {% endif %}
            <input type="hidden" name="contact[tags]" value="waitlist,first-edition">
            <input type="hidden" name="return_to" value="/pages/sealed">
            <div class="hero-atelier__row">
              <input type="email" name="contact[email]" placeholder="Your email" aria-label="Email address" autocomplete="email" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" required>
              <button type="submit" class="hero-atelier__btn" data-waitlist-submit>{{ section.settings.button_label }}</button>
            </div>
          {% endif %}
        {% endform %}
        <p class="hero-atelier__fine">{{ section.settings.fine_print }}</p>
        {% if section.settings.expectations != blank %}
          <p class="hero-atelier__fine hero-atelier__fine--small">{{ section.settings.expectations }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero atelier",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A first glimpse of The Reading Hour"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Objects for slow living & well-loved stories"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Heirloom pieces for the rituals that make a life beautiful."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter the guest book"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "Guest book members will receive the first invitation to shop."
    },
    {
      "type": "textarea",
      "id": "expectations",
      "label": "What signing up means",
      "default": "A letter when there is something worth telling you. Your address stays with the house. Leave whenever you like.",
      "info": "Sits under the fine print. Answers the quiet question people ask before handing over an email."
    }
  ],
  "presets": [
    {
      "name": "Hero atelier"
    }
  ]
}
{% endschema %}
