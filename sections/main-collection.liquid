<div class="collection-banner">
  <div class="page-width">
    <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p>{{ collection.description | strip_html }}</p>
    {% endif %}
  </div>
</div>

<div class="page-width" style="padding-bottom: var(--section-space);">
  {% paginate collection.products by 12 %}
    {% if collection.products.size > 0 %}
      <div class="product-grid">
        {% for product in collection.products %}
          {% render 'product-card', product: product, number: forloop.index %}
        {% endfor %}
      </div>
    {% else %}
      <div class="utility-page">
        <h2>Between editions</h2>
        <p style="color: var(--ink-soft);">Nothing here at the moment — we print something new and never look back. The letter will tell you first.</p>
      </div>
    {% endif %}

    {% if paginate.pages > 1 %}
      <nav class="pagination" aria-label="Pagination">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}">&larr; Previous</a>
        {% endif %}
        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {% elsif part.title == paginate.current_page %}
            <span class="current">{{ part.title }}</span>
          {% else %}
            <span>{{ part.title }}</span>
          {% endif %}
        {% endfor %}
        {% if paginate.next %}
          <a href="{{ paginate.next.url }}">Next &rarr;</a>
        {% endif %}
      </nav>
    {% endif %}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "An edition, not a catalog"
    }
  ]
}
{% endschema %}
