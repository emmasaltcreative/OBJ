{% stylesheet %}
.product__video { margin-top: 1rem; border: 1px solid var(--line); background: var(--color-paper); }
.product__video video { display: block; width: 100%; height: auto; }
.product__video--embed iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }

.note-board { margin-top: clamp(2rem, 4vw, 3rem); }
.note-board__head { margin-bottom: 1.4rem; }
.note-board__head h2 { margin: 0; font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
.note-board__grid {
  list-style: none; margin: 0; padding: 0;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.8rem, 1.6vw, 1.2rem);
}
@media (max-width: 620px) { .note-board__grid { grid-template-columns: repeat(2, 1fr); } }
.note-card { margin: 0; text-align: center; }
.note-card__media {
  position: relative; aspect-ratio: 1 / 1; overflow: hidden;
  border: 1px solid var(--line); background: var(--color-paper); margin-bottom: 0.7rem;
}
.note-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
.note-card__plate {
  position: absolute; inset: 0; display: grid; place-items: center;
  font-family: var(--font-display); font-style: italic;
  font-size: clamp(2.4rem, 5vw, 3.4rem); color: var(--color-accent); opacity: 0.55;
}
.note-card__name {
  display: block; font-family: var(--font-sans);
  font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
}
.note-card__text {
  display: block; margin-top: 0.25rem; font-style: italic;
  font-size: 0.86rem; color: var(--ink-soft);
}
.cta-note--ships { font-style: normal; }

.product-card--more {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: clamp(2rem, 4vw, 3rem);
  background-color: var(--color-background);
  background-image: url({{ 'obj-quatrefoil-tile.svg' | asset_url }});
  background-size: 112px 112px;
  background-repeat: repeat;
}
.product-card--more .product-card__no { font-style: italic; color: var(--color-accent); margin-bottom: 0.6rem; }
.product-card--more .product-card__title { font-style: italic; margin-bottom: 0.6rem; }
.product-card--more .product-card__coming-text {
  color: var(--ink-soft); font-size: 0.98rem; margin: 0; max-width: 22rem;
}
{% endstylesheet %}
