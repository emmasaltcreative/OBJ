{% stylesheet %}
.product__video { margin-top: 1rem; border: 1px solid var(--line); background: var(--color-paper); }
.product__video video { display: block; width: 100%; height: auto; }
.product__video--embed iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; }

.cta-note--ships { font-style: normal; }

.product-card--more {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: clamp(2rem, 4vw, 3rem);
  background-color: var(--color-background);
  background-image: url({{ 'obj-quatrefoil-tile.svg' | asset_url }});
  background-size: 112px 112px;
  background-repeat: repeat;
}
.product-card--more .product-card__no { font-style: italic; color: var(--color-accent); margin-bottom: 0.6rem; }
.product-card--more .product-card__title { font-style: italic; margin-bottom: 0.6rem; }
.product-card--more .product-card__coming-text {
  color: var(--ink-soft); font-size: 0.98rem; margin: 0; max-width: 22rem;
}
{% endstylesheet %}
