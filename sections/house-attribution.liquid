{%- comment -%}
  "What the signature means." Every piece carries "… by Betty Jaletti" on
  the first line of its description, which means the house presents it — not
  that the house made it. Saying so out loud, in public, is the single most
  trust-building thing on this page, so it gets a section of its own.

  Each row states one of the three things the house actually does, an
  example, and where a buyer can go and verify it for themselves. Keep the
  "where to check" column honest: it is the whole point of the section.
{%- endcomment -%}

<section class="house-credit section">
  <div class="page-width">
    <div class="house-credit__head">
      <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}
        <div class="house-credit__intro prose">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="house-credit__rows">
        <div class="house-credit__legend" aria-hidden="true">
          <span>{{ section.settings.col_role }}</span>
          <span>{{ section.settings.col_example }}</span>
          <span>{{ section.settings.col_proof }}</span>
        </div>

        {%- for block in section.blocks -%}
          <div class="house-credit__row" {{ block.shopify_attributes }}>
            <div class="house-credit__cell house-credit__cell--role">
              <span class="house-credit__mini">{{ section.settings.col_role }}</span>
              <h3>{{ block.settings.role }}</h3>
            </div>
            <div class="house-credit__cell">
              <span class="house-credit__mini">{{ section.settings.col_example }}</span>
              <p>{{ block.settings.example }}</p>
            </div>
            <div class="house-credit__cell">
              <span class="house-credit__mini">{{ section.settings.col_proof }}</span>
              <p>{{ block.settings.proof }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <div class="house-credit__footnote prose prose--quiet">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "House attribution",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The signature"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What “by Betty Jaletti” means — and what it does not"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Every piece in the house is signed <em>… by Betty Jaletti</em> on the first line of its description. That signature means the house <strong>presents</strong> the piece: chose it, stands behind it, and will answer for it. It does not mean the house made it.</p><p>Some pieces we make. Some we choose, and some we choose and pair. Which one it was is written on the piece's own page, every time, in its own words — so you never have to guess which kind of “handmade” you are reading.</p>"
    },
    {
      "type": "text",
      "id": "col_role",
      "label": "Column 1 label",
      "default": "What the house did"
    },
    {
      "type": "text",
      "id": "col_example",
      "label": "Column 2 label",
      "default": "For example"
    },
    {
      "type": "text",
      "id": "col_proof",
      "label": "Column 3 label",
      "default": "Where to check it"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote",
      "default": "<p>Where a piece was made by someone else, their name goes in the maker field on the product, not just in our copy. We would rather name a good French glovemaker than let you assume we are one.</p>"
    }
  ],
  "blocks": [
    {
      "type": "credit",
      "name": "Credit",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "role",
          "label": "What the house did",
          "default": "Made it"
        },
        {
          "type": "textarea",
          "id": "example",
          "label": "Example",
          "default": "A Woman Remembered — blended and bottled by hand, in small batches."
        },
        {
          "type": "textarea",
          "id": "proof",
          "label": "Where to check it",
          "default": "On the product page, under “The Making”."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "House attribution",
      "blocks": [
        {
          "type": "credit",
          "settings": {
            "role": "Made it",
            "example": "A Woman Remembered — blended and bottled by hand, in small batches.",
            "proof": "On the product page, under “The Making”."
          }
        },
        {
          "type": "credit",
          "settings": {
            "role": "Chose it, and paired it",
            "example": "The Brownstone Tote — the bag and the silk scarf were chosen separately, then put together by the house.",
            "proof": "On the product page, under “The Pairing”."
          }
        },
        {
          "type": "credit",
          "settings": {
            "role": "Chose it",
            "example": "The Out-the-Door Gloves — made in France by Glove Story, chosen by the house.",
            "proof": "On the product page, under “The Maker”, with the maker named."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
.house-credit { border-bottom: 1px solid var(--line); }
.house-credit__head { max-width: 48rem; margin-bottom: clamp(2.2rem, 4vw, 3.2rem); }
.house-credit__head h2 { text-wrap: balance; }
.house-credit__intro { font-size: 1.05rem; }
.house-credit__intro p:last-child { margin-bottom: 0; }

.house-credit__rows { border-top: 1px solid var(--line-strong); }
.house-credit__legend,
.house-credit__row {
  display: grid;
  grid-template-columns: minmax(10rem, 0.9fr) 1.5fr 1.1fr;
  gap: clamp(1rem, 3vw, 2.5rem);
}
.house-credit__legend {
  padding: 0.9rem 0;
  border-bottom: 1px solid var(--line);
  font-family: var(--font-sans);
  font-size: 0.64rem;
  font-weight: 500;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--ink-soft);
}
.house-credit__row {
  padding: clamp(1.4rem, 2.6vw, 2rem) 0;
  border-bottom: 1px solid var(--line);
}
.house-credit__cell p { margin: 0; color: var(--ink-soft); font-size: 0.98rem; }
.house-credit__cell--role h3 {
  margin: 0;
  font-size: clamp(1.25rem, 2vw, 1.6rem);
  font-style: italic;
  color: var(--color-accent);
}

/* The column labels stay in the accessible tree on wide screens, where the
   legend above is decorative, so a screen reader still hears which column
   it is reading. On narrow screens they become the visible labels. */
.house-credit__mini {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
}

@media (max-width: 840px) {
  .house-credit__legend { display: none; }
  .house-credit__row {
    grid-template-columns: 1fr;
    gap: 1.1rem;
    padding-block: clamp(1.6rem, 5vw, 2.2rem);
  }
  .house-credit__mini {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    clip-path: none;
    white-space: normal;
    display: block;
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }
}

.house-credit__footnote {
  margin-top: clamp(1.8rem, 3vw, 2.5rem);
  max-width: 44rem;
  font-style: italic;
}
.house-credit__footnote p:last-child { margin-bottom: 0; }
{% endstylesheet %}
