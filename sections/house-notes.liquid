{%- comment -%}
  A numbered set of house notes, for editorial pages that want words
  rather than another photograph.
{%- endcomment -%}

<section class="house-notes section">
  <div class="page-width">
    <div class="house-notes__head">
      <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <p class="house-notes__intro">{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    <ol class="house-notes__list">
      {% for block in section.blocks %}
        <li class="house-notes__item" {{ block.shopify_attributes }}>
          <span class="house-notes__numeral">{{ block.settings.numeral }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {% endfor %}
    </ol>

    {% if section.settings.footnote != blank %}
      <p class="house-notes__footnote">{{ section.settings.footnote }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "House notes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "House rules" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The rule of the purse" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "footnote", "label": "Footnote" }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Note",
      "settings": [
        { "type": "text", "id": "numeral", "label": "Numeral", "default": "I." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "It must hold a hardback" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A bag that cannot carry a book is a decoration." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "House notes" }]
}
{% endschema %}

{% stylesheet %}
.house-notes { background: var(--color-paper); border-block: 1px solid var(--line); }
.house-notes__head { max-width: 46rem; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
.house-notes__intro { color: var(--ink-soft); font-size: 1.1rem; }
.house-notes__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid var(--line);
}
@media (max-width: 760px) { .house-notes__list { grid-template-columns: 1fr; } }
.house-notes__item {
  padding: clamp(1.8rem, 3vw, 2.6rem) clamp(1.5rem, 3vw, 2.6rem);
  border-bottom: 1px solid var(--line);
}
.house-notes__item:nth-child(odd) { border-right: 1px solid var(--line); }
@media (max-width: 760px) { .house-notes__item:nth-child(odd) { border-right: 0; } }
.house-notes__numeral {
  display: block;
  font-family: var(--font-display);
  font-style: italic;
  font-size: 1.25rem;
  color: var(--color-accent);
  margin-bottom: 0.7rem;
}
.house-notes__item h3 { margin-bottom: 0.4rem; }
.house-notes__item p { color: var(--ink-soft); font-size: 0.98rem; margin: 0; }
.house-notes__footnote { margin-top: 2rem; font-style: italic; font-size: 0.95rem; color: var(--ink-soft); }
{% endstylesheet %}