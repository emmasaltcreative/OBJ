{%- comment -%}
  A numbered set of house notes — the typographic cousin of the ritual
  section, for editorial pages that want words rather than another photograph.
{%- endcomment -%}

<section class="house-notes section">
  <div class="page-width">
    <div class="house-notes__head">
      <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <p class="house-notes__intro">{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    <ol class="house-notes__list">
      {% for block in section.blocks %}
        <li class="house-notes__item" {{ block.shopify_attributes }}>
          <span class="house-notes__numeral">{{ block.settings.numeral }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {% endfor %}
    </ol>

    {% if section.settings.footnote != blank %}
      <p class="house-notes__footnote">{{ section.settings.footnote }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "House notes",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "House rules"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The rule of the purse"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote"
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Note",
      "settings": [
        {
          "type": "text",
          "id": "numeral",
          "label": "Numeral",
          "default": "I."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "It should hold a hardback"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A bag that cannot carry a book is a decoration."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "House notes"
    }
  ]
}
{% endschema %}
