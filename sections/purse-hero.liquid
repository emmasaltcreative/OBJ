{%- comment -%}
  In Her Purse — debut landing hero.

  The first screen names the piece, its price, and the way to buy it.
  A visitor who arrived from an ad should not have to scroll past the
  house's opinions to find out what is for sale and what it costs.
{%- endcomment -%}

{%- liquid
  assign featured = section.settings.product
  if featured == blank
    assign featured_handle = section.settings.product_handle
    if featured_handle != blank
      assign featured = all_products[featured_handle]
    endif
  endif

  assign featured_variant = blank
  if featured != blank
    assign featured_variant = featured.selected_or_first_available_variant
  endif

  assign price_label = ''
  if featured_variant != blank
    assign price_label = featured_variant.price | money
  endif

  assign primary_label = section.settings.button_label | replace: '[price]', price_label
  assign primary_href = section.settings.button_link
  if primary_href == blank
    if featured != blank
      assign primary_href = featured.url
    else
      assign primary_href = '#brownstone-tote'
    endif
  endif
-%}

<section class="purse-hero">
  <div class="page-width purse-hero__intro">
    <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p class="hero__sub">{{ section.settings.subheading }}</p>

    {%- if price_label != blank -%}
      <p class="purse-hero__price">
        <span>{{ price_label }}</span>
        {%- if section.settings.price_note != blank -%}
          <span class="purse-hero__price-note">{{ section.settings.price_note }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if primary_label != blank -%}
      <div class="purse-hero__actions">
        <a href="{{ primary_href }}" class="btn btn--solid">{{ primary_label }}</a>
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '#the-edition' }}" class="purse-hero__secondary">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <figure class="purse-hero__figure">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', class: 'purse-hero__img', widths: '600, 900, 1400, 2000', alt: section.settings.image.alt | default: section.settings.image_alt }}
    {% elsif featured.featured_image != blank %}
      {{ featured.featured_image | image_url: width: 2000 | image_tag: loading: 'eager', class: 'purse-hero__img', widths: '600, 900, 1400, 2000', alt: featured.featured_image.alt | default: section.settings.image_alt }}
    {% else %}
      {% render 'brownstone-image', loading: 'eager', alt: section.settings.image_alt, class: 'purse-hero__img' %}
    {% endif %}
    <figcaption class="purse-hero__caption">
      <span>{{ section.settings.caption_left }}</span>
      <span>{{ section.settings.caption_right }}</span>
    </figcaption>
  </figure>
</section>
<div class="ticking" aria-hidden="true"></div>

{% schema %}
{
  "name": "Purse hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Pick the piece this landing leads with. Its price appears under the subheading and can be printed inside the button with [price]."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "text",
      "id": "product_handle",
      "label": "Featured product handle",
      "default": "the-brownstone-tote",
      "info": "Used when no product is picked above."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The debut collection"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "In <em>Her</em> Purse"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A debut of bags, beginning with one. The Brownstone Tote by Betty."
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Note beside the price",
      "default": "Made to order · ships in 3–5 days"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Brownstone Tote — [price] →",
      "info": "Use [price] to print the featured product's price."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave blank to link to the featured product."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Second link label",
      "default": "See both pieces ↓"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Second link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Use the photograph from the ad. Leave empty to use the featured product's image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "The Brownstone Tote by Betty, a Café Noir faux suede tote with a silk scarf knotted at the handle"
    },
    {
      "type": "text",
      "id": "caption_left",
      "label": "Caption left",
      "default": "No. 1"
    },
    {
      "type": "text",
      "id": "caption_right",
      "label": "Caption right",
      "default": "The Brownstone Tote by Betty"
    }
  ],
  "presets": [
    {
      "name": "Purse hero"
    }
  ]
}
{% endschema %}
