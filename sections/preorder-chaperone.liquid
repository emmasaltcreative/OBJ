{%- liquid
  assign preorder_product = section.settings.product
  if preorder_product == blank
    assign handle = section.settings.product_handle | default: 'the-chaperone'
    assign preorder_product = all_products[handle]
  endif

  assign variant = blank
  assign has_variant = false
  if preorder_product != blank
    assign variant = preorder_product.selected_or_first_available_variant
    if variant != blank
      assign has_variant = true
    endif
  endif

  assign cta = section.settings.cta
  if preorder_product.metafields.custom.cta_label.value != blank
    assign cta = preorder_product.metafields.custom.cta_label.value
  endif

  assign ships = section.settings.ships | default: 'With the first edition'
-%}

<section class="preorder-feature section" id="chaperone-preorder">
  <div class="page-width preorder-feature__grid">
    <div class="preorder-feature__media">
      {% if preorder_product.featured_image %}
        {{ preorder_product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600, 900, 1400', alt: preorder_product.featured_image.alt | default: preorder_product.title }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <div class="preorder-feature__copy">
      <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
      <h2>{{ preorder_product.title | default: section.settings.heading }}</h2>
      <p class="product__type">{{ section.settings.dek | default: preorder_product.type }}</p>

      <div class="prose">
        {% if preorder_product.description != blank %}
          {{ preorder_product.description }}
        {% else %}
          <p>{{ section.settings.text }}</p>
        {% endif %}
      </div>

      <div class="product__price-kicker">Preorder price</div>
      <p class="preorder-feature__price">
        {% if has_variant %}
          {{ variant.price | money }}
        {% else %}
          {{ section.settings.fallback_price }}
        {% endif %}
      </p>
      {% if request.design_mode %}
        {% if has_variant and variant.price != 7900 %}
          <div class="errors">The Chaperone preorder is $79. This variant is {{ variant.price | money }}. Set the price to $79.00.</div>
        {% elsif preorder_product == blank %}
          <div class="errors">Import the-chaperone.csv so this preorder can be added to the parcel at $79.</div>
        {% endif %}
      {% endif %}
      <p class="preorder-feature__promise">{{ section.settings.promise }}</p>

      {% if has_variant %}
        {% form 'product', preorder_product %}
          {{ form.errors | default_errors }}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <input type="hidden" name="quantity" value="1">
          {% render 'preorder-properties', ships: ships %}
          <button
            type="submit"
            name="add"
            class="btn btn--solid"
            {% unless variant.available %}disabled{% endunless %}
          >
            {% if variant.available %}
              {{ cta }}
            {% else %}
              {{ section.settings.closed_label }}
            {% endif %}
          </button>
        {% endform %}
        <a class="link-arrow preorder-feature__more" href="{{ preorder_product.url }}">The particulars</a>
      {% else %}
        <a class="btn btn--solid" href="/products/{{ section.settings.product_handle | default: 'the-chaperone' }}">{{ cta }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Chaperone preorder",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Preorder · No. 1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Chaperone"
    },
    {
      "type": "text",
      "id": "dek",
      "label": "Dek",
      "default": "A coat for the paperback."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Linen and paper, cut to the common paperback and stamped by the house. It does not exist yet. Claim it at the first-edition price and we will make yours when the edition opens."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "product_handle",
      "label": "Product handle",
      "default": "the-chaperone",
      "info": "Used when no product is picked above. Import the-chaperone.csv so this resolves to The Chaperone at $79."
    },
    {
      "type": "text",
      "id": "fallback_price",
      "label": "Price before the product is published",
      "default": "$79"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Button",
      "default": "Preorder — escort my paperback →"
    },
    {
      "type": "text",
      "id": "closed_label",
      "label": "Closed label",
      "default": "Preorder closed"
    },
    {
      "type": "text",
      "id": "ships",
      "label": "Ship note",
      "default": "With the first edition",
      "info": "Saved on the order as the Ships line-item property."
    },
    {
      "type": "text",
      "id": "promise",
      "label": "Promise",
      "default": "Charged today. Numbered to the edition, then sent the long way."
    }
  ],
  "presets": [
    {
      "name": "Chaperone preorder"
    }
  ]
}
{% endschema %}
