{%- comment -%}
  The product's videos.

  The main product gallery loops product.media but only outputs the images,
  so a video attached to a product never reaches the page. This section
  renders them, and disappears entirely when a product has none — so it is
  safe to sit on every product template.
{%- endcomment -%}

{%- liquid
  assign has_video = false
  for media in product.media
    if media.media_type == 'video' or media.media_type == 'external_video'
      assign has_video = true
      break
    endif
  endfor
-%}

{%- if has_video -%}
  <section class="section product-film">
    <div class="page-width narrow">
      {%- if section.settings.heading != blank -%}
        <div class="section-header">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
      {%- endif -%}

      {%- for media in product.media -%}
        {%- if media.media_type == 'video' -%}
          <div class="product-film__player">
            {{ media | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1200x' }}
          </div>
        {%- elsif media.media_type == 'external_video' -%}
          <div class="product-film__player product-film__player--embed">
            {{ media | external_video_tag }}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.caption != blank -%}
        <p class="product-film__caption">{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product film",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In motion" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The film", "info": "Leave blank to show the video with no heading." },
    { "type": "text", "id": "caption", "label": "Caption" }
  ],
  "presets": [{ "name": "Product film" }]
}
{% endschema %}

{% stylesheet %}
.product-film { padding-top: 0; }
.product-film__player {
  border: 1px solid var(--line);
  background: var(--color-paper);
  margin-bottom: 1rem;
}
.product-film__player video,
.product-film__player img {
  display: block;
  width: 100%;
  height: auto;
}
.product-film__player--embed iframe {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  border: 0;
}
.product-film__caption {
  margin: 0;
  font-style: italic;
  font-size: 0.92rem;
  color: var(--ink-soft);
  text-align: right;
}
{% endstylesheet %}
