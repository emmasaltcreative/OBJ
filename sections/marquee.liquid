<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {% for i in (1..2) %}
      {% for j in (1..3) %}
        <span class="marquee__item">{{ section.settings.phrase_1 }}</span>
        <span class="marquee__item">{{ section.settings.phrase_2 }}</span>
        <span class="marquee__item">{{ section.settings.phrase_3 }}</span>
      {% endfor %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "text",
      "id": "phrase_1",
      "label": "Phrase 1",
      "default": "petits plaisirs, faits exprès"
    },
    {
      "type": "text",
      "id": "phrase_2",
      "label": "Phrase 2",
      "default": "take the long way home"
    },
    {
      "type": "text",
      "id": "phrase_3",
      "label": "Phrase 3",
      "default": "using the good things is the special occasion"
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}
