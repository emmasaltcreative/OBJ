{%- comment -%}
  02 — The emotional origin of the piece.

  The long narrative that used to run down the buy column, moved below the
  purchase area where it can be read rather than scrolled past.

  Body copy falls back to the product description, so a merchant editing the
  description in admin still changes the page. The template may override it
  when the page wants a curated version — the description also feeds search
  results, collection cards and structured data, and the three jobs do not
  always want the same words.
{%- endcomment -%}

{%- liquid
  assign body = section.settings.body
  if body == blank
    assign body = product.description
  endif
-%}

{%- if body != blank -%}
  <section class="story section" id="{{ section.settings.anchor | default: 'the-story' }}">
    <div class="page-width">
      <div class="story__inner">
        <div class="story__head">
          {% if section.settings.numeral != blank %}
            <span class="seq-numeral">{{ section.settings.numeral }}</span>
          {% endif %}
          {% if section.settings.eyebrow != blank %}
            <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
          {% endif %}
          <h2>{{ section.settings.heading }}</h2>
        </div>

        <div class="story__body prose{% if section.settings.drop_cap %} story__body--cap{% endif %}">
          {{ body }}
        </div>

        {% if section.settings.pull_quote != blank %}
          <p class="story__quote">{{ section.settings.pull_quote }}</p>
        {% endif %}

        {%- comment -%}
          The story is the last long read before the footer, so it carries a way
          back to the buy box. One variant means there is nothing to guess and we
          add it outright; with options to choose, we send them up to pick, the
          same bargain the sticky bar makes.
        {%- endcomment -%}
        {%- if section.settings.show_cta and product != blank and product.available -%}
          <div class="story__cta">
            {%- if product.variants.size == 1 -%}
              {% form 'product', product, class: 'story__cta-form' %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" name="add" class="btn btn--solid">
                  {{ section.settings.cta_label }}
                </button>
              {% endform %}
            {%- else -%}
              <button type="button" class="btn btn--solid" data-story-scroll>
                {{ section.settings.cta_choose_label }}
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if section.settings.show_cta -%}
    <style>
      .story__cta {
        margin-top: clamp(2rem, 4vw, 2.8rem);
        padding-top: clamp(1.4rem, 2.5vw, 1.9rem);
        border-top: 1px solid var(--line);
      }
      .story__cta .btn { display: inline-block; }
      .story__cta-form { margin: 0; }
    </style>
    <script>
      (function () {
        var btn = document.querySelector('[data-story-scroll]');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var anchor = document.querySelector('[data-buy-button]');
          if (!anchor) return;
          anchor.scrollIntoView({ behavior: 'smooth', block: 'center' });
          var field = document.querySelector('[data-option-select]');
          if (field) { window.setTimeout(function () { field.focus({ preventScroll: true }); }, 500); }
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Product story",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "numeral", "label": "Numeral", "default": "02" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why it exists" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Woman Remembered" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "info": "Leave blank to use the product description."
    },
    { "type": "checkbox", "id": "drop_cap", "label": "Drop cap", "default": true },
    {
      "type": "text",
      "id": "pull_quote",
      "label": "Closing line",
      "info": "Set apart at the end. Keep it to one sentence."
    },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "the-story" },
    { "type": "checkbox", "id": "show_cta", "label": "Show a buy call to action", "default": true },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Call to action label",
      "default": "Add to my parcel →",
      "info": "Used when the piece has a single variant and can be added outright."
    },
    {
      "type": "text",
      "id": "cta_choose_label",
      "label": "Call to action label, with options",
      "default": "Choose yours →",
      "info": "Used when there is a size or colour to pick. Sends the reader to the buy box."
    }
  ],
  "presets": [{ "name": "Product story" }]
}
{% endschema %}
