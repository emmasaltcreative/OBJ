<section class="section">
  <div class="page-width narrow">
    <span class="eyebrow eyebrow--accent">The house journal</span>
    <h1>{{ blog.title }}</h1>

    {% paginate blog.articles by 8 %}
      {% for article in blog.articles %}
        <article class="article-card">
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time>
          <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <p style="color: var(--ink-soft);">{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p>
          <a href="{{ article.url }}" class="link-arrow">Read on</a>
        </article>
      {% else %}
        <p style="font-style: italic; color: var(--ink-soft);">No entries yet. We write when there is something worth writing about.</p>
      {% endfor %}

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Pagination">
          {% if paginate.previous %}<a href="{{ paginate.previous.url }}">&larr; Previous</a>{% endif %}
          {% if paginate.next %}<a href="{{ paginate.next.url }}">Next &rarr;</a>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
