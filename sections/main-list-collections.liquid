<section class="section">
  <div class="page-width">
    <div class="section-header">
      <span class="eyebrow eyebrow--accent">The editions</span>
      <h1>Collections</h1>
    </div>
    <div class="product-grid">
      {% for collection in collections %}
        <div class="product-card">
          <div class="product-card__media">
            {% if collection.featured_image %}
              {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <h3 class="product-card__title"><a href="{{ collection.url }}">{{ collection.title }}</a></h3>
          <p class="product-card__type">{{ collection.products_count }} object{% if collection.products_count != 1 %}s{% endif %}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
