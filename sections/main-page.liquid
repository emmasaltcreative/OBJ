<section class="section">
  <div class="page-width narrow">
    <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
    <h1>{{ page.title }}</h1>
    <div class="prose" style="margin-top: 2rem;">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From the house"
    }
  ]
}
{% endschema %}
