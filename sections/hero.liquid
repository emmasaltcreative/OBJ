<section class="hero">
  <div class="page-width">
    <span class="eyebrow eyebrow--accent">{{ section.settings.eyebrow }}</span>
    <h1>{{ section.settings.heading }}</h1>
    <p class="hero__sub">{{ section.settings.subheading }}</p>
    {% if section.settings.button_label != blank %}
      {%- assign hero_href = section.settings.button_link -%}
      {%- if hero_href == blank and section.settings.button_label contains 'Chaperone' -%}
        {%- assign hero_href = '/products/the-chaperone' -%}
      {%- endif -%}
      <a href="{{ hero_href | default: routes.all_products_collection_url }}" class="link-arrow">
        {{ section.settings.button_label }}
      </a>
    {% endif %}

    {% if section.settings.image != blank %}
      <div class="hero__image">
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '800, 1200, 1800, 2400' }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Maison Betty Jaletti"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Small, useful, <em>unreasonably pretty</em> things."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "For the ones who still do it the long way on purpose. Printed, bound, poured, and packed for you — one at a time."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Browse the First Edition"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
