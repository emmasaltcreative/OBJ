      {
        "type": "color",
        "id": "color_paper",
        "label": "Paper (cards & panels)",
        "default": "#FDFAF3"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink (text)",
        "default": "#2A2320"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (green)",
