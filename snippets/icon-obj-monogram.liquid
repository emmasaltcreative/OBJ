{%- comment -%}
  The house quatrefoil, standing in for the old OBJ monogram so the one mark
  is used everywhere. Inline so it inherits currentColor. The file keeps its
  historical name, and the svg keeps the .icon-obj-monogram class, so render
  calls and the existing sizing rules stay stable.
{%- endcomment -%}
<svg class="icon-obj-monogram" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <mask id="objMonoQfHole">
    <rect width="100" height="100" fill="white"/>
    <circle cx="50" cy="50" r="14.5" fill="black"/>
  </mask>
  <g mask="url(#objMonoQfHole)" fill="currentColor">
    <circle cx="50" cy="26.5" r="21"/>
    <circle cx="26.5" cy="50" r="21"/>
    <circle cx="73.5" cy="50" r="21"/>
    <circle cx="50" cy="73.5" r="21"/>
  </g>
</svg>
