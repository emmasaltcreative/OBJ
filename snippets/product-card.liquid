{% comment %}
  Renders a product card.
  Accepts:
  - product: {Object} product
  - number: {Integer} optional edition number ("No. 1")
{% endcomment %}

{%- liquid
  assign fallback_asset = 'product-chaperone.svg'
  case product.handle
    when 'the-good-lines'
      assign fallback_asset = 'product-good-lines.svg'
    when 'one-more-chapter'
      assign fallback_asset = 'product-candle.svg'
    when 'the-good-glass'
      assign fallback_asset = 'product-good-glass.svg'
  endcase
-%}

{%- capture preorder_flag -%}{%- render 'is-preorder', product: product -%}{%- endcapture -%}
{%- assign is_preorder = false -%}
{%- if preorder_flag contains 'true' -%}
  {%- assign is_preorder = true -%}
{%- endif -%}
{%- assign edition = product.metafields.custom.edition_number.value -%}
{%- if edition == blank -%}
  {%- if product.handle == 'the-chaperone' or product.handle == 'the-brownstone-tote' -%}
    {%- assign edition = 1 -%}
  {%- else -%}
    {%- assign edition = number -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Quick add used to wait for edition_state == 'open', which kept it hidden on
  every card while the house sold the debut pieces anyway. It now follows the
  one fact that matters: whether Shopify will actually sell this piece today.
  A retired edition still hides it.
{%- endcomment -%}
{%- assign show_quick_add = false -%}
{%- if product.available and settings.edition_state != 'retired' -%}
  {%- assign show_quick_add = true -%}
{%- endif -%}

{%- comment -%}
  Availability and dispatch, per piece. A collection cannot promise one way of
  making things when it holds a tote and a perfume, so each card says its own.
  Set custom.dispatch_note on a product to publish its exact window — a
  preorder's ship date, a longer make time — and it wins over the defaults.
{%- endcomment -%}
{%- assign dispatch = product.metafields.custom.dispatch_note.value -%}
{%- if dispatch == blank and product.available -%}
  {%- if is_preorder -%}
    {%- assign dispatch = 'Preorder — paid today, ships with its edition' -%}
  {%- else -%}
    {%- assign dispatch = 'In stock — ships in 3–5 business days' -%}
  {%- endif -%}
{%- endif -%}

<div class="product-card">
  {% if edition %}
    <div class="product-card__no">No. {{ edition }}</div>
  {% endif %}

  <div class="product-card__media">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', alt: product.featured_image.alt | default: product.title }}
    {% elsif product.handle == 'the-brownstone-tote' %}
      {% render 'brownstone-image', alt: product.title, class: 'brownstone-card-img' %}
    {% else %}
      <img src="{{ fallback_asset | asset_url }}" alt="{{ product.title | escape }}" width="800" height="1000" loading="lazy">
    {% endif %}
    {%- if show_quick_add -%}
    {%- form 'product', product, class: 'quick-add-form' -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      {%- if is_preorder -%}
        {% render 'preorder-properties' %}
      {%- endif -%}
      <button class="quick-add" type="submit" aria-label="Add {{ product.title | escape }} to parcel">
        {% if is_preorder %}Preorder +{% else %}Quick add +{% endif %}
      </button>
    {%- endform -%}
    {%- endif -%}
  </div>

  <h3 class="product-card__title">
    <a href="{{ product.url }}">{{ product.title }}</a>
  </h3>

  {% if product.type != blank %}
    <p class="product-card__type">{{ product.type }}</p>
  {% endif %}

  <div class="product-card__price">
    {% render 'price', product: product %}
    {% if is_preorder %}
      {% if product.available %}
        <span class="badge badge--preorder">Preorder</span>
      {% else %}
        <span class="badge badge--preorder">Preorder closed</span>
      {% endif %}
    {% elsif product.available == false %}
      <span class="badge">Between editions</span>
    {% endif %}
  </div>

  {%- if dispatch != blank -%}
    <p class="product-card__dispatch" style="margin: 0.55rem 0 0; font-family: var(--font-sans); font-size: 0.72rem; letter-spacing: 0.08em; line-height: 1.6; color: var(--ink-soft);">{{ dispatch }}</p>
  {%- endif -%}
</div>
