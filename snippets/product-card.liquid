{% comment %}
  Renders a product card.
  Accepts:
  - product: {Object} product
  - number: {Integer} optional edition number ("No. 1")
{% endcomment %}

<div class="product-card">
  {%- assign edition = product.metafields.custom.edition_number.value | default: number -%}
  {% if edition %}
    <div class="product-card__no">No. {{ edition }}</div>
  {% endif %}

  <div class="product-card__media">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', alt: product.featured_image.alt | default: product.title }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  <h3 class="product-card__title">
    <a href="{{ product.url }}">{{ product.title }}</a>
  </h3>

  {% if product.type != blank %}
    <p class="product-card__type">{{ product.type }}</p>
  {% endif %}

  <div class="product-card__price">
    {% render 'price', product: product %}
    {% if product.metafields.custom.preorder.value %}
      <span class="badge badge--preorder" style="margin-left: 0.7em;">Preorder</span>
    {% elsif product.available == false %}
      <span class="badge" style="margin-left: 0.7em;">Between editions</span>
    {% endif %}
  </div>
</div>
