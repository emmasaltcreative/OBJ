{% comment %}
  Renders a product card.
  Accepts:
  - product: {Object} product
  - number: {Integer} optional edition number ("No. 1")
  - quick_add: {Boolean} optional — show an add-to-cart on the card
  - quick_add_label: {String} optional button label
  - choose_label: {String} optional label when the piece has options to pick
{% endcomment %}

{%- capture preorder_flag -%}{%- render 'is-preorder', product: product -%}{%- endcapture -%}
{%- assign is_preorder = false -%}
{%- if preorder_flag contains 'true' -%}
  {%- assign is_preorder = true -%}
{%- endif -%}
{%- assign edition = product.metafields.custom.edition_number.value -%}
{%- if edition == blank -%}
  {%- if product.handle == 'the-chaperone' or product.handle == 'the-brownstone-tote' -%}
    {%- assign edition = 1 -%}
  {%- else -%}
    {%- assign edition = number -%}
  {%- endif -%}
{%- endif -%}

<div class="product-card{% if quick_add %} product-card--shoppable{% endif %}">
  {% if edition %}
    <div class="product-card__no">No. {{ edition }}</div>
  {% endif %}

  <div class="product-card__media">
    {% if product.featured_image %}
      {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', alt: product.featured_image.alt | default: product.title }}
    {% elsif product.handle == 'the-brownstone-tote' %}
      {% render 'brownstone-image', alt: product.title, class: 'brownstone-card-img' %}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  <h3 class="product-card__title">
    <a href="{{ product.url }}">{{ product.title }}</a>
  </h3>

  {% if product.type != blank %}
    <p class="product-card__type">{{ product.type }}</p>
  {% endif %}

  <div class="product-card__price">
    {% render 'price', product: product %}
    {% if is_preorder %}
      {% if product.available %}
        <span class="badge badge--preorder">Preorder</span>
      {% else %}
        <span class="badge badge--preorder">Preorder closed</span>
      {% endif %}
    {% elsif product.available == false %}
      <span class="badge">Between editions</span>
    {% endif %}
  </div>

  {%- if quick_add and product.available -%}
    {%- assign card_variant = product.selected_or_first_available_variant -%}
    <div class="product-card__add">
      {%- if product.has_only_default_variant and card_variant != blank -%}
        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ card_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          {%- if is_preorder -%}
            {% render 'preorder-properties' %}
          {%- endif -%}
          <button type="submit" name="add" class="btn btn--full">
            {%- if is_preorder -%}
              Preorder
            {%- else -%}
              {{ quick_add_label | default: 'Add to my parcel' }}
            {%- endif -%}
          </button>
        {% endform %}
      {%- else -%}
        <a class="btn btn--full" href="{{ product.url }}">{{ choose_label | default: 'Choose yours' }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
