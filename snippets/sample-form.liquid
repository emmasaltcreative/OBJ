{%- comment -%}
  "Grab a sample" — a card scented by hand, folded into a house envelope
  and closed with a wax seal, sent by post.

  Because it travels by post it needs a street address, so this is a
  contact form rather than a newsletter signup: every field lands in the
  shop's contact notification, ready to address an envelope from. No app
  and no metafield plumbing required.

  Accepts:
  - product: {Object} the product being sampled

  Copy lives in Theme settings → Free samples.
{%- endcomment -%}

{%- liquid
  assign summary_label = settings.sample_summary_label | default: 'Grab a sample — free'
  assign summary_note = settings.sample_summary_note | default: 'Free · posted to you'
  assign heading = settings.sample_heading | default: 'Try it on first'
  assign intro = settings.sample_text
  assign button_label = settings.sample_button | default: 'Send me the sample →'
  assign note = settings.sample_note
  assign success = settings.sample_success | default: 'Sealed and sent. Watch the letterbox — it travels the long way.'
-%}

{% form 'contact', id: 'sample', class: 'sample' %}
  <details class="sample__disclosure"{% if form.posted_successfully? or form.errors %} open{% endif %}>
    <summary class="sample__summary">
      <span class="sample__seal" aria-hidden="true"></span>
      <span class="sample__summary-label">{{ summary_label }}</span>
      <span class="sample__summary-note">{{ summary_note }}</span>
    </summary>

    <div class="sample__panel">
      <h2 class="sample__heading">{{ heading }}</h2>

      {% if intro != blank %}
        <p class="sample__intro">{{ intro }}</p>
      {% endif %}

      {% if form.posted_successfully? %}
        <p class="sample__sent">{{ success }}</p>
      {% else %}
        {% if form.errors %}
          <div class="errors">{{ form.errors | default_errors }}</div>
        {% endif %}

        <input type="hidden" name="contact[Requesting a sample of]" value="{{ product.title | escape }}">
        <input type="hidden" name="contact[Product]" value="{{ shop.url }}{{ product.url }}">
        <input
          type="hidden"
          name="contact[body]"
          value="A free sample of {{ product.title | escape }} was requested from the product page. Post a scented card to the address below."
        >

        <div class="sample__grid">
          <div class="field field--full">
            <label for="SampleName">Name</label>
            <input type="text" id="SampleName" name="contact[Name]" autocomplete="name" required>
          </div>

          <div class="field field--full">
            <label for="SampleEmail">Email</label>
            <input
              type="email"
              id="SampleEmail"
              name="contact[email]"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
            >
          </div>

          <div class="field field--full">
            <label for="SampleAddress">Street address</label>
            <input type="text" id="SampleAddress" name="contact[Address]" autocomplete="address-line1" required>
          </div>

          <div class="field field--full">
            <label for="SampleAddress2">Apartment, floor, etc. <span class="sample__optional">optional</span></label>
            <input type="text" id="SampleAddress2" name="contact[Address line 2]" autocomplete="address-line2">
          </div>

          <div class="field">
            <label for="SampleCity">City</label>
            <input type="text" id="SampleCity" name="contact[City]" autocomplete="address-level2" required>
          </div>

          <div class="field">
            <label for="SampleProvince">State or province</label>
            <input type="text" id="SampleProvince" name="contact[State or province]" autocomplete="address-level1">
          </div>

          <div class="field">
            <label for="SampleZip">Postal code</label>
            <input type="text" id="SampleZip" name="contact[Postal code]" autocomplete="postal-code" required>
          </div>

          <div class="field">
            <label for="SampleCountry">Country</label>
            <select id="SampleCountry" name="contact[Country]" autocomplete="country-name" required>
              <option value="" selected disabled>Choose a country</option>
              {{ country_option_tags }}
            </select>
          </div>

          <div class="field field--full">
            <label for="SampleNote">A note, if you like <span class="sample__optional">optional</span></label>
            <textarea id="SampleNote" name="contact[Note]" rows="2"></textarea>
          </div>
        </div>

        <label class="sample__check" for="SampleLetters">
          <input type="checkbox" id="SampleLetters" name="contact[Letters]" value="Yes — add me to the letters">
          <span>Write to me when a new edition opens.</span>
        </label>

        <button type="submit" class="btn btn--solid btn--full">{{ button_label }}</button>

        {% if note != blank %}
          <p class="sample__note">{{ note }}</p>
        {% endif %}
      {% endif %}
    </div>
  </details>
{% endform %}

<script>
  /* Open the disclosure on arrival at #sample — from the wax seal on a
     collection card, or Shopify's own redirect after the form posts.
     Without JavaScript the form still opens itself on post and on error. */
  (function () {
    function openSample() {
      if (window.location.hash !== '#sample') return;
      var form = document.getElementById('sample');
      if (!form) return;
      var panel = form.querySelector('details');
      if (panel) panel.open = true;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      form.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    }
    if (window.location.hash === '#sample') {
      window.addEventListener('load', function () { window.setTimeout(openSample, 100); });
    }
    window.addEventListener('hashchange', openSample);
  })();
</script>
