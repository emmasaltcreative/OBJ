{%- comment -%}
  A way back up, at the foot of the page rather than floating over it. The
  editorial pages run long — the story, the portrait and the particulars sit
  below the buy box — so the reader who reaches the end is a long way from it.

  Rendered from layout/theme.liquid, between the main content and the footer,
  so every template gets it. Hidden from assistive tech is wrong here: it is a
  real control, so it is a button with a real label.
{%- endcomment -%}

<div class="back-to-top">
  <button type="button" class="back-to-top__btn" data-back-to-top>
    {{ 'Back to the top' }}
    <span class="back-to-top__arrow" aria-hidden="true">&#8593;</span>
  </button>
</div>

<style>
  .back-to-top {
    border-top: 1px solid var(--line);
    padding: clamp(1.6rem, 3vw, 2.4rem) 1rem;
    text-align: center;
  }

  .back-to-top__btn {
    appearance: none;
    background: none;
    border: 0;
    padding: 0.4rem 0.2rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 0.2s ease;
  }

  .back-to-top__btn:hover,
  .back-to-top__btn:focus-visible {
    color: var(--color-accent);
  }

  .back-to-top__arrow {
    display: inline-block;
    margin-left: 0.5em;
    transition: transform 0.2s ease;
  }

  .back-to-top__btn:hover .back-to-top__arrow {
    transform: translateY(-0.18em);
  }

  /* The sticky buy bar sits over the foot of the page when it is showing. */
  body.has-sticky-buy .back-to-top { padding-bottom: clamp(3.5rem, 8vw, 5rem); }
</style>

<script>
  (function () {
    var btn = document.querySelector('[data-back-to-top]');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      var skip = document.querySelector('.skip-to-content');
      if (skip) { skip.focus({ preventScroll: true }); }
    });
  })();
</script>
