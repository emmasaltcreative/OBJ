<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <meta name="p:domain_verify" content="f92cd78610ef788b386a49ba43645517"/>
  <title>
    {{- page_title -}}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- liquid
    assign meta_description = page_description
    if meta_description == blank
      case request.page_type
        when 'product'
          assign meta_description = product.description | strip_html | truncate: 155
        when 'collection'
          assign meta_description = collection.description | strip_html | truncate: 155
        when 'article'
          assign meta_description = article.excerpt_or_content | strip_html | truncate: 155
        when 'index'
          assign meta_description = 'An American maison for the ones who take the slow way. Edition I: In Her Purse. Edition II: The Reading Hour, now open for preorder.'
      endcase
    endif
  -%}
  {% if meta_description != blank %}
    <meta name="description" content="{{ meta_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/svg+xml" href="{{ 'obj-floral-mark.svg' | asset_url }}">

  <meta property="og:site_name" content="Oh Betty Jaletti">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
  {% if meta_description != blank %}
    <meta property="og:description" content="{{ meta_description | escape }}">
  {% endif %}
  {%- assign og_image = 'obj-share-image.jpg' | asset_url | prepend: 'https:' -%}
  {%- case request.page_type -%}
    {%- when 'product' -%}
      <meta property="og:type" content="product">
      {% if product.featured_image %}
        {%- assign og_image = product.featured_image | image_url: width: 1200 | prepend: 'https:' -%}
      {% endif %}
    {%- when 'article' -%}
      <meta property="og:type" content="article">
      {% if article.image %}
        {%- assign og_image = article.image | image_url: width: 1200 | prepend: 'https:' -%}
      {% endif %}
    {%- else -%}
      <meta property="og:type" content="website">
      {% if request.page_type == 'collection' and collection.featured_image %}
        {%- assign og_image = collection.featured_image | image_url: width: 1200 | prepend: 'https:' -%}
      {% endif %}
  {%- endcase -%}
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:secure_url" content="{{ og_image }}">
  <meta name="twitter:image" content="{{ og_image }}">
  <meta name="twitter:card" content="summary_large_image">

  {% if request.page_type == 'index' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Oh Betty Jaletti",
      "alternateName": "Maison Betty Jaletti",
      "url": {{ shop.url | json }},
      "logo": {{ 'obj-floral-mark.svg' | asset_url | prepend: 'https:' | json }},
      "foundingDate": "2026",
      "description": "Oh Betty Jaletti is an American maison for the ones who take the slow way: useful, unreasonably pretty things, made with intention and released in considered quantities. Edition I, In Her Purse, opens with the Brownstone Tote. Edition II, The Reading Hour, is open for preorder."
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Oh Betty Jaletti",
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ shop.url }}/search?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>
  {% endif %}

  {%- comment -%}
    Fonts are self-hosted theme assets (@font-face in base.css) — no
    fonts.googleapis.com round trip. Preload the display faces that render
    above the fold; the rest load on demand from the same CDN.
  {%- endcomment -%}
  {{ 'fraunces.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% if request.page_type == 'index' %}
    {{ 'fraunces-italic.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% endif %}

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'purse-preorder.css' | asset_url | stylesheet_tag }}
  {{ 'obj-pattern.css' | asset_url | stylesheet_tag }}

  <style>
    :root {
      --color-background: {{ settings.color_background }};
      --color-paper: {{ settings.color_paper }};
      --color-ink: {{ settings.color_ink }};
      --color-accent: {{ settings.color_accent }};
      --color-stripe: {{ settings.color_stripe }};
    }
    [hidden] { display: none !important; }
  </style>

  <script>
    window.BettyRoutes = {
      cart: {{ routes.cart_url | json }},
      cartAdd: {{ routes.cart_add_url | json }},
      cartChange: {{ routes.cart_change_url | json }}
    };
    window.BettyCurrency = {{ cart.currency.iso_code | json }};
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JX4MHEKBWG"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JX4MHEKBWG');
  </script>

  {{ content_for_header }}
</head>

<body class="template-{{ request.page_type | handle }}">
  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <div class="page-overlay" data-overlay hidden></div>
  {% render 'cart-drawer' %}
  <div class="toast" data-toast role="status" aria-live="polite"></div>
</body>
</html>
