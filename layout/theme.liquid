<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">

  <title>
    {{- page_title -}}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Jost:wght@400;500&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">

  {{ 'base.css' | asset_url | stylesheet_tag }}

  <style>
    :root {
      --color-background: {{ settings.color_background }};
      --color-paper: {{ settings.color_paper }};
      --color-ink: {{ settings.color_ink }};
      --color-accent: {{ settings.color_accent }};
      --color-stripe: {{ settings.color_stripe }};
    }
  </style>

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {{ content_for_header }}

  {%- comment -%}
    Meta (Facebook) pixel: do NOT hardcode it here.
    Pixel 946586624876543 is already served by the official Facebook & Instagram
    app as a Shopify web pixel (id 2765684789), registered through
    Settings > Customer events. That integration fires the full funnel,
    covers checkout and the thank-you page, and attaches a shared eventID
    so Meta can deduplicate the browser event against the Conversions API
    server event. Adding the base code to this layout would double-count
    every event and cannot reach checkout. See also: no Custom Pixel should
    be created for this same pixel ID, for the same reason.
  {%- endcomment -%}
</head>

<body class="template-{{ request.page_type | handle }}">
  <a class="skip-to-content" href="#MainContent">Skip to content</a>

  {% sections 'header-group' %}

  <main id="MainContent" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}
</body>
</html>
