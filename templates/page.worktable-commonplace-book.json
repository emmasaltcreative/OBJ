      "settings": {
        "concept_id": "commonplace-book",
        "collection_label": "The Reading Hour",
        "index_url": "/pages/the-worktable",
        "title": "The Commonplace<br>Book",
        "subtitle": "Thoughts, kept close",
        "story": "<p>Sewn in sections so it lies flat without being held down, because a book you write in has to stay open. Cream wove that takes ink without ghosting, an index at the front in the commonplace tradition, one silk ribbon.</p><p>For the reader who argues in the margin and wins; not for someone who wants a book too handsome to write in.</p>",
        "worktable_note": "Ruled, dotted or blank. And whether the index stays: nobody fills it in, and it is the best thing about it.",
        "ask": "What do you think?",
        "status": "worktable"
      }
