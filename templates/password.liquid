{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;1,500&family=Jost:wght@400;500&family=Lora:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <div class="utility-page" style="padding-top: 15vh;">
    <span class="eyebrow eyebrow--accent">Maison Betty Jaletti</span>
    <h1>Oh Betty <em style="color: var(--color-accent);">Jaletti</em></h1>
    <p style="font-style: italic; color: var(--ink-soft); font-size: 1.15rem;">
      The house is setting the table. Small, useful, unreasonably pretty things — arriving soon, the unhurried way.
    </p>

    {% form 'customer' %}
      {% if form.posted_successfully? %}
        <p class="newsletter__note">Wonderful. You'll be the first to know.</p>
      {% else %}
        <input type="hidden" name="contact[tags]" value="prospect, password page">
        <div class="newsletter__form">
          <input type="email" name="contact[email]" placeholder="Your email" aria-label="Email" required>
          <button type="submit" class="btn btn--solid">Notify me</button>
        </div>
      {% endif %}
    {% endform %}

    <details style="margin-top: 3rem;">
      <summary style="font-family: var(--font-sans); font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer;">Enter with password</summary>
      <div style="max-width: 22rem; margin: 1.5rem auto 0;">
        {% form 'storefront_password' %}
          {{ form.errors | default_errors }}
          <input type="password" name="password" placeholder="Password" aria-label="Password">
          <button type="submit" class="btn btn--full" style="margin-top: 0.8rem;">Enter</button>
        {% endform %}
      </div>
    </details>
  </div>
</body>
</html>
