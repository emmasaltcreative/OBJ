<div class="utility-page">
  <span class="eyebrow eyebrow--accent">Welcome back</span>
  <h1>Sign in</h1>

  <div class="customer-form">
    {% form 'customer_login' %}
      {% if form.errors %}
        <div class="errors">{{ form.errors | default_errors }}</div>
      {% endif %}
      <div class="field">
        <label for="CustomerEmail">Email</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="CustomerPassword">Password</label>
        <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn btn--solid btn--full">Sign in</button>
    {% endform %}

    <div class="form-links">
      <a href="#recover" onclick="document.getElementById('RecoverForm').hidden = false; return false;">Forgot your password?</a>
      &nbsp;·&nbsp;
      <a href="{{ routes.account_register_url }}">Create an account</a>
    </div>

    <div id="RecoverForm" hidden style="margin-top: 2.5rem;">
      <h3>Reset your password</h3>
      {% form 'recover_customer_password' %}
        {% if form.posted_successfully? %}
          <p class="newsletter__note">A letter is on its way with instructions.</p>
        {% endif %}
        {% if form.errors %}
          <div class="errors">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="field">
          <label for="RecoverEmail">Email</label>
          <input type="email" id="RecoverEmail" name="email" required>
        </div>
        <button type="submit" class="btn btn--full">Send reset link</button>
      {% endform %}
    </div>
  </div>
</div>
